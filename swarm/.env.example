# Copy to swarm/.env and fill in. swarm/.env is git-ignored.
# Never export these in the terminal where your coding agent runs.

# The model the agents use, as provider:model. Any provider works:
#   openai:<model id>          anthropic:<model id>      gemini:<model id>
#   deepseek:<model id>        moonshot:<model id>       openrouter:<vendor/model>
#   compat:<model id>          any OpenAI-compatible API (Groq, Together, Mistral,
#                              xAI, Fireworks...): also set SWARM_BASE_URL below
# Pick the cheapest model that supports structured outputs or JSON mode, and add
# its price to swarm/prices.json. The course uses openai:gpt-6-luna (already priced).
SWARM_MODEL=openai:gpt-6-luna

# Reasoning effort sent to OpenAI reasoning models. Low keeps agents fast and
# cheap. Leave empty to send none (the harness also drops it automatically if a
# model rejects it).
SWARM_REASONING_EFFORT=low

# Only the key for the provider you use is needed.
SWARM_OPENAI_API_KEY=
SWARM_ANTHROPIC_API_KEY=
SWARM_GEMINI_API_KEY=
SWARM_DEEPSEEK_API_KEY=
SWARM_MOONSHOT_API_KEY=
SWARM_OPENROUTER_API_KEY=

# For compat: the provider's OpenAI-compatible base URL (the part before
# /chat/completions, from its docs) and its API key.
SWARM_BASE_URL=
SWARM_API_KEY=
